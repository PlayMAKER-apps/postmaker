{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostMAKER",
  "version": "0.3.0",
  "identifier": "com.playmaker.apps.postmaker",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:5173/",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../../../dist/desktop"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "PostMAKER",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
