{
  "name": "postmaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && node scripts/finalize-pwa.mjs",
    "build:desktop": "npm run typecheck && vite build --mode desktop --config apps/web/vite.config.ts",
    "dev:desktop": "vite --mode desktop --config apps/web/vite.config.ts --host 127.0.0.1",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "audit:dependencies": "npm audit --audit-level=high && cargo tree --manifest-path apps/desktop/src-tauri/Cargo.toml --locked",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
