{
  "name": "postmaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/web", "packages/*"],
  "scripts": {
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && node scripts/finalize-pwa.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
